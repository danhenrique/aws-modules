{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSCloudTrailAclCheck20150319-4f7eca26-2a83-4e05-a6a1-75399fb3c342",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "${bucket_arn}",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudtrail:${region}:${account_id}:trail/${trail_name}"
        }
      }
    },
    {
      "Sid": "AWSCloudTrailWrite20150319-b70633a5-3ff1-4270-a6c6-4b6ce1e8c759",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "${bucket_arn}/AWSLogs/${org_id}/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "arn:aws:cloudtrail:${region}:${account_id}:trail/${trail_name}"
        }
      }
    },
    {
      "Sid": "AWSCloudTrailAclCheck20150319-e4dc080c-2efd-4573-950c-524cdfd5114b",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "${bucket_arn}",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudtrail:${region}:${account_id}:trail/${trail_name}"
        }
      }
    },
    {
      "Sid": "AWSCloudTrailWrite20150319-2bcac5c5-ec8c-45a3-894f-b56aa2f22e9b",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "${bucket_arn}/AWSLogs/${org_id}/*",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudtrail:${region}:${account_id}:trail/${trail_name}",
          "s3:x-amz-acl": "bucket-owner-full-control"
        }
      }
    },
    {
      "Sid": "AWSCloudTrailWrite20150319-3f2172c6-82ec-4444-b3e6-b2722eb5127f",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "${bucket_arn}/AWSLogs/${org_id}/*",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudtrail:${region}:${account_id}:trail/${trail_name}",
          "s3:x-amz-acl": "bucket-owner-full-control"
        }
      }
    }
  ]
}
