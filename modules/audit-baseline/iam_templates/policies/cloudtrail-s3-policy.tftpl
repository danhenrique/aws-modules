{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSCloudTrailAclCheck20150319-cff7d77d-1856-4707-88ff-26c8c4dc6a05",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "${bucket_arn}",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudtrail:sa-east-1:${account_id}:trail/${trail_name}"
        }
      }
    },
    {
      "Sid": "AWSCloudTrailWrite20150319-49892603-cd16-43db-b33e-8026f740cc48",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "${bucket_arn}/AWSLogs/${account_id}/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "AWS:SourceArn": "arn:aws:cloudtrail:sa-east-1:${account_id}:trail/${trail_name}"
        }
      }
    }
  ]
}
