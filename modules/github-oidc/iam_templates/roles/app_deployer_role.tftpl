{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Effect": "Allow",
      "Principal": {
        "Federated": "${github_oidc_arn}"
      },
      "Condition": {
        "StringLike": {
            "repo:${github_org}/aws-${account_name}-app-*:environment:${environment}"
          ]
        },
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        }
      }
    }
  ]
}
